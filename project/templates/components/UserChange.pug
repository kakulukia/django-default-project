.userChange

  h2.text-h6.mb-4 Benutzerverwaltung
  v-alert(v-if="!store.user" type="info" variant="tonal")
    | Bitte melde dich über das Schloss an, um die Benutzerverwaltung zu verwenden.
  template(v-else)
    .user(v-for="user in users" :key="user.id")
      .form.mb-1
        v-text-field(
          v-model="user.username"
          label="Change the username .."
          density="compact"
          hide-details
        )
      v-btn(
        color="primary"
        variant="tonal"
        @click="updateUser(user)"
      ) 🎉
    .user
      .form.mb-1
        v-text-field(
          v-model="username"
          label="Add a user .."
          density="compact"
          hide-details
        )
      v-btn(
        color="primary"
        variant="tonal"
        @click="addUser()"
      ) 🎉
