#!/usr/bin/env bash
# Rebase and validate the Cookiecutter variant of the runnable project.
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

die() {
  printf 'update-cookiecutter: %s\n' "$*" >&2
  exit 1
}

if [[ $# -gt 0 ]]; then
  if [[ $# -eq 1 && "$1" == "--help" ]]; then
    printf 'Usage: ./update-cookiecutter\nRebase feature/cookiecutter onto local main and run template tests.\n'
    exit 0
  fi
  die "No arguments expected. Use --help for usage."
fi

command -v uv >/dev/null || die "uv is not installed."
command -v sass >/dev/null || die "Sass is not installed."
original_branch=$(git symbolic-ref --quiet --short HEAD) || die "Start from a local branch."
[[ -z "$(git status --porcelain)" ]] || die "Review and commit all changes, including untracked files, first."
git show-ref --verify --quiet refs/heads/main || die "Local main branch is missing."
git show-ref --verify --quiet refs/heads/feature/cookiecutter || die "Local feature/cookiecutter branch is missing."

git switch feature/cookiecutter
if ! git -c merge.renames=true -c merge.directoryRenames=true rebase --merge main; then
  die "Rebase failed. Resolve or abort it before rerunning this script."
fi

if ! env -u VIRTUAL_ENV -u UV_PROJECT_ENVIRONMENT -u PYTHONPATH \
  uv run --no-project --python 3.14 --with 'cookiecutter==2.7.1' python tests/test_template.py; then
  die "Template validation failed. The template checkout is available for inspection."
fi

git switch "$original_branch"
printf 'Cookiecutter branch updated and validated. Review its diff before publishing.\n'
